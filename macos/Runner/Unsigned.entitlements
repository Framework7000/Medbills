<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Used only for the downloadable build made on GitHub, which has no Apple
     developer team: no app sandbox and no keychain group (both need a team),
     so the app can run after "right-click > Open" and still keep the login. -->
<dict>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
